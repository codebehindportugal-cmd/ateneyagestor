APP_NAME="Backup Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Lisbon
APP_URL=https://gestao.example.com

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# ASSUNCAO: ajustar para a base de dados real do teu VPS/Plesk.
# Para um teste rapido sem MySQL, podes usar sqlite (ver README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backup_manager
DB_USERNAME=backup_manager
DB_PASSWORD=

# Drivers simples (ficheiro/sincrono) -- evita depender de Redis ou de
# tabelas extra de cache/jobs para este MVP. Podes mudar mais tarde se
# precisares de filas assincronas a serio.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

PURCHASE_INVOICE_MAX_UPLOAD_SIZE=10240
PURCHASE_INVOICE_STORAGE_DISK=local
PURCHASE_INVOICE_STORAGE_PATH=private/purchase-invoices
PURCHASE_INVOICE_TESSERACT_LANGUAGE=por+eng
PURCHASE_INVOICE_MIN_PDF_TEXT_LENGTH=100
OCRMYPDF_BINARY=ocrmypdf
PDFTOTEXT_BINARY=pdftotext
PDFTOPPM_BINARY=pdftoppm
TESSERACT_BINARY=tesseract

MAIL_MAILER=log
MAIL_FROM_ADDRESS="naoresponder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Claude (botao "Resolver com o Claude" nas tarefas dos projectos) ---
# So no .env da MAQUINA QUE CORRE O WORKER (o PC), nao no servidor.
# O token gera-se no painel, em Projectos > Token do worker.
CLAUDE_PANEL_URL=https://gestao.ateneya.com
CLAUDE_PANEL_TOKEN=
# Em Windows costuma ser preciso o caminho completo do .cmd:
# CLAUDE_BINARY="C:\Users\andre\AppData\Roaming\npm\claude.cmd"
CLAUDE_BINARY=claude
# Alternativa fiavel em Windows quando a pasta do utilizador tem espacos ou acentos.
# Descobre-se com: php artisan claude:check
# CLAUDE_NODE_SCRIPT=''
CLAUDE_TIMEOUT=900
CLAUDE_PERMISSION_MODE=dontAsk
CLAUDE_DISALLOWED_TOOLS="Read(**/.env),Read(**/.env.*),Read(**/*.pem),Read(**/*.key),Read(**/auth.json),Read(**/id_rsa*)"
# Modo "Continuar e alterar ficheiros": escreve, mas nao faz commit nem migrations.
CLAUDE_PERMISSION_MODE_WRITE=acceptEdits
CLAUDE_ALLOWED_TOOLS_WRITE="Read,Edit,Write,Grep,Glob,Bash(git diff *),Bash(git status *),Bash(git log *)"
CLAUDE_ALLOWED_TOOLS="Read,Grep,Glob,Bash(git log *),Bash(git status *),Bash(git diff *)"
# true = arranca mais rapido mas ignora o CLAUDE.md do projecto e obriga a ANTHROPIC_API_KEY
CLAUDE_BARE=false
CLAUDE_WORKER_SLEEP=5
# Copia so de leitura dos sites que so existem no servidor (code_source = remote)
CLAUDE_SNAPSHOT_TTL=60
CLAUDE_SNAPSHOT_MAX_MB=200
# So e preciso se CLAUDE_BARE=true, ou se o worker correr sem login do Claude Code
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Notificacoes push (app ntfy no telemovel)
# ---------------------------------------------------------------------------
# Vale para o servidor de producao, que e quem corre as verificacoes.
# O topico e a UNICA coisa que protege isto no ntfy.sh publico: quem souber o
# nome le tudo. Usa um nome longo e aleatorio, nunca "ateneya".
# Na app: Subscribe to topic > escreve exactamente o mesmo nome.
NTFY_ENABLED=true
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# So se o servidor ntfy exigir autenticacao (o publico nao exige).
# NTFY_TOKEN=
NTFY_TIMEOUT=8
# Cada tipo de aviso liga-se e desliga-se por si.
NTFY_AVISA_SITES=true
NTFY_AVISA_SERVIDORES=true
NTFY_AVISA_SYNCS=true
NTFY_AVISA_BACKUPS=true
