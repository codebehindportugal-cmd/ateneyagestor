# Binários Windows locais (poppler/tesseract) — no servidor usam-se os do sistema
/bin/

# Ferramentas Claude/agentes locais
/.claude/
/.agents/

# Scripts e logs locais de debug/deploy (Windows)
/_local/
/*.bat
/*-log.txt
/check-*.txt
/deploy-*.txt
/*.log
DEPLOY_STATUS.txt
deploy-status.html

# Copias de seguranca deixadas por editores e por correccoes a mao. Sem esta
# regra vao para o repositorio e para producao — o SyncProjectResource.php.bak
# tinha 34 KB. Nao sao carregadas (o PSR-4 so' apanha .php), mas nao ha razao
# para la' estarem.
*.bak
*.bak-*
*.orig

# ⚠️ 17/09/2026: o repositorio esteve PUBLICO com o .env de producao la dentro
# (um "env" sem ponto e dois .env.bak), o token de um agente e os logs. Tudo o
# que for configuracao local de uma maquina fica fora do git — o que conta e o
# .example ao lado.
/env
/.env.*
!/.env.example
!/.env.production.example
/index.html
agents/backup_agent/agent.yaml
agents/backup_agent/secrets.yaml
agents/backup_agent/config.yaml
agents/backup_agent/results.json
agents/backup_agent/keys/
agents/backup_agent/logs/
agents/backup_agent/venv/
__pycache__/
*.pyc
syncer/**/.vs/
syncer/**/logs/
syncer/**/*.sql
syncer/**/venv/
syncer/**/.env
syncer/**/config.yaml
